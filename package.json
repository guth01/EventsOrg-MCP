{
  "name": "eventsorg-mcp",
  "version": "1.0.0",
  "description": "An open-source Model Context Protocol (MCP) server and background autonomous agent designed to run the logistics of live events.",
  "main": "build/index.js",
  "type": "module",
  "bin": {
    "eventsorg-mcp": "build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "tsx src/seed.ts && tsx src/index.ts --transport http",
    "start:agent": "tsx src/agent.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "ai",
    "agent",
    "twilio"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/express": "^5.0.6",
    "axios": "^1.16.1",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "googleapis": "^171.4.0",
    "nodemailer": "^8.0.7",
    "twilio": "^6.0.2",
    "untun": "^0.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.7.0",
    "@types/nodemailer": "^8.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3"
  }
}
